cmake_minimum_required(VERSION ${cmake_version})
project(
  ${project_name}
  VERSION 0.1.0
  LANGUAGES CXX
  DESCRIPTION "${description}"
)

${includes}

set(CMAKE_CXX_STANDARD ${cpp_standard})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(fmt REQUIRED)

# include(cmake/fetched-libs.cmake)

add_library(${project_name}-lib STATIC src/${project_name_safe}.cpp)
target_include_directories(${project_name}-lib PUBLIC include)
target_link_libraries(${project_name}-lib PUBLIC fmt::fmt)

add_executable(${executable_name} src/main.cpp)
target_include_directories(${executable_name} PRIVATE src)
target_link_libraries(${executable_name} PRIVATE ${project_name}-lib)
target_compile_options(${executable_name} PRIVATE -Wall -Wextra -Wconversion)

## sanitizer
## may require installing additional library for the compiler

# target_compile_options(${executable_name} PRIVATE -fsanitize=address,leak,undefined)
# target_link_options(${executable_name} PRIVATE -fsanitize=address,leak,undefined)
