cmake_minimum_required(VERSION {0})
project({1} VERSION 0.1.0)

{3}

set(CMAKE_CXX_STANDARD {4})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(fmt REQUIRED)

# include(cmake/fetched-libs.cmake)

add_library({1}-lib)
target_sources({1}-lib PUBLIC FILE_SET CXX_MODULES FILES src/{2}.cxx)
target_link_libraries({1}-lib PUBLIC fmt::fmt)

add_executable({5} src/main.cxx)
target_include_directories({5} PRIVATE src)
target_link_libraries({5} PRIVATE {1}-lib)
target_compile_options({5} PRIVATE -Wall -Wextra -Wconversion)

## sanitizer
## may require installing additional library for the compiler

# target_compile_options({5} PRIVATE -fsanitize=address,leak,undefined)
# target_link_options({5} PRIVATE -fsanitize=address,leak,undefined)
